{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // The wrappers are declaration files, and skipLibCheck would skip exactly
    // the check that matters here: that every name they re-export still exists
    // in the build output.
    "skipLibCheck": false
  },
  "include": ["esm/**/*.d.mts", "storages/**/*.d.ts"],
  "exclude": ["node_modules"]
}
